# Evolution API connection
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key

# Optional: default instance used when a tool call omits the "instance" argument
EVOLUTION_DEFAULT_INSTANCE=

# Optional: per-request timeout in milliseconds (default 30000)
EVOLUTION_TIMEOUT_MS=

# Optional: true/1/yes hides every tool that sends or changes state
# (send_text, send_media, create_instance, disconnect_instance, configure_webhook)
EVOLUTION_READ_ONLY=false

# Optional: true/1/yes asks a human to confirm before any write tool runs
# (confirmation card or elicitation dialog). Clients that can show neither are refused.
EVOLUTION_CONFIRM_WRITES=false

# Optional: comma-separated numbers that send_text/send_media may reach.
# Empty means no restriction. Example: 5511999999999,5521988887777
EVOLUTION_ALLOWED_NUMBERS=
